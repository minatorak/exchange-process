# Example environment variables. Copy to .env.local and fill in real values —
# .env.local is gitignored and must never be committed. Precedence: process
# environment > .env.local.

# Shared PostgreSQL with exchange-adapter; the pool pins
# search_path=process,exchange,public (see src/infrastructure/postgres/pool.rs).
DATABASE_URL=postgres://user:password@localhost:5432/trading

# Redpanda/Kafka — created-event consumer + outbox publisher.
KAFKA_BOOTSTRAP=redpanda:9092

# The adapter's account-v2 storage crypto, shared by deployment:
# standard base64, exactly 32 bytes — same value as the adapter's
# ADAPTER__ACCOUNT_V2_STORAGE_KEY. Never commit; never log.
CREDENTIAL_DECRYPT_KEY=
# Same value as the adapter's ADAPTER__ACCOUNT_V2_STORAGE_KEY_ID.
CREDENTIAL_DECRYPT_KEY_ID=

# Health probes (the only listener; ADR-0004).
HEALTH_ADDR=0.0.0.0:8090

# Optional: config file path (default: config.toml in the working directory)
# EXCHANGE_PROCESS_CONFIG=config.toml
